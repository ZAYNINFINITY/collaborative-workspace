# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.npm-cache/
backend/.npm-cache/

# Environment files — keep examples, exclude actual secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# NOTE: Do NOT gitignore frontend/dist — Vercel needs it if not building
# But since we build on Vercel, dist is regenerated each deploy, so ignore it:
frontend/dist/
frontend/build/
frontend/.next/
backend/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/error.log
backend/audit-results.log

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*.vsix

# Test coverage
coverage/

# Vercel local dev files — DO commit vercel.json (deployment config)
# but exclude the CLI local state:
.vercel/

# MongoDB local data
data/db/
