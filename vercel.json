{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://collaborative-workspace-backend-production-68d2.up.railway.app/api/$1"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "https://collaborative-workspace-backend-production-68d2.up.railway.app/socket.io/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    }
  ]
}
