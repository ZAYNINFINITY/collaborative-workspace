NODE_ENV=development
PORT=5000

# Local development defaults (do not reuse these values in production).
# Production config should be set in Railway/Vercel environment variables.

# MongoDB
MONGO_URI=

# Secrets (use strong random strings in production)
JWT_SECRET=dev_jwt_secret_change_me
SESSION_SECRET=dev_session_secret_change_me

# CORS / URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# OAuth (optional for local dev; register real callbacks for production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
