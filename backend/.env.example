## Backend environment variables (Railway / local)
## Copy to `backend/.env` for local dev, or set these as Railway "Variables" for production.

# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB (Required)
# Get a free MongoDB Atlas cluster at https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/collaborative-workspace?retryWrites=true&w=majority

# Railway Mongo note:
# Railway often provides a proxied URL like:
# mongodb://USER:PASSWORD@<host>:<port>/<dbName>?authSource=admin
# You can paste that directly into MONGO_URI, or set MONGODB_URL / DATABASE_URL instead.

# JWT & CSRF Secrets (Required in production)
# Generate strong random strings (64+ chars).
JWT_SECRET=change-me-long-random-string
SESSION_SECRET=change-me-long-random-string
CSRF_SECRET=change-me-long-random-string

# Frontend URL (Required for production CORS + OAuth redirects)
# For this repo's Vercel production deployment:
CLIENT_URL=https://collaborative-workspace-rosy.vercel.app

# Optional: extra allowed CORS origins (comma-separated) for staging/custom domains.
# Example: https://staging.example.com,https://preview.example.com
ALLOWED_ORIGINS=

# Optional: public base URL for OAuth callback routes.
# If unset, production defaults to CLIENT_URL (recommended when Vercel proxies `/api/*`),
# and development defaults to SERVER_URL / localhost.
OAUTH_PUBLIC_BASE_URL=

# Optional: explicitly set backend origin (used mainly for dev defaults)
SERVER_URL=http://localhost:5000

# OAuth (Optional - for social login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# AI Assistant (Optional)
# If both providers are set, `AI_PROVIDER` chooses; otherwise it auto-picks what's available.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Email (Optional - for invitations)
# Gmail requires an "App Password" if 2FA is enabled.
# Preferred variable names (SMTP_*)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Legacy variable names (still supported)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
