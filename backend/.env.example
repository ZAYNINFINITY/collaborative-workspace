# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB (Required)
# Get a free MongoDB Atlas cluster at https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/collaborative-workspace?retryWrites=true&w=majority

# JWT & Session Secrets (Generate strong random strings)
JWT_SECRET=your-super-secret-jwt-key-change-this
SESSION_SECRET=your-super-secret-session-key-change-this
CSRF_SECRET=your-super-secret-csrf-key-change-this

# Frontend URL (Required for production CORS)
CLIENT_URL=https://your-frontend.vercel.app

# OAuth (Optional - for social login)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (Optional - for invitations)
# Preferred variable names (SMTP_*)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Legacy variable names (still supported)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
