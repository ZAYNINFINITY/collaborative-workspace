# Vite reads VITE_ prefixed variables only.
# REACT_APP_ variables are ignored by Vite — they were CRA convention.
#
# In PRODUCTION on Vercel:
#   - API calls use /api (same-origin, proxied to Railway by vercel.json)
#   - Socket uses window.location.origin (same, proxied via /socket.io/*)
#   - No env vars needed for production — config.js handles it automatically
#
# In DEVELOPMENT (localhost):
#   - Set VITE_API_BASE_URL to your local backend
#   - Leave blank to use the default http://localhost:5000/api

VITE_API_BASE_URL=http://localhost:5000/api
