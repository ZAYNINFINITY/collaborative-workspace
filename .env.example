## Monorepo environment variables (local dev convenience)
## - Backend reads `backend/.env`
## - Frontend reads `frontend/.env` (or `.env.local`) via Vite/React tooling
##
## For production, set backend vars in Railway and keep frontend on Vercel using `/api` proxy.

# ======================
# Backend (Railway/local)
# ======================

# Server
NODE_ENV=production
PORT=5000

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/collaborative-workspace?retryWrites=true&w=majority

# Railway Mongo note:
# Railway may expose the DB as MONGO_URL / MONGODB_URL / DATABASE_URL. Backend accepts any of these.

# Secrets (required)
JWT_SECRET=change-me-long-random-string
SESSION_SECRET=change-me-long-random-string
CSRF_SECRET=change-me-long-random-string

# Your public frontend origin (required in production)
CLIENT_URL=https://collaborative-workspace-rosy.vercel.app

# Optional: extra CORS origins (comma-separated)
ALLOWED_ORIGINS=

# Optional: AI assistant
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ======================
# Frontend (Vercel/local)
# ======================

# Optional override:
# - Production on Vercel should stay as `/api` (default).
# - Local dev usually uses `http://localhost:5000` (the code adds `/api`).
REACT_APP_API_BASE_URL=
