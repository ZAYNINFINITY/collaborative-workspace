# MongoDB Connection (Required for production)
# Get a free MongoDB Atlas cluster at https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/collaborative-workspace?retryWrites=true&w=majority

# Session Secret (Required - generate a random string)
SESSION_SECRET=your-super-secret-session-key-change-this

# JWT Secret (Required - generate a random string)
JWT_SECRET=your-jwt-secret-key-change-this

# Client URL (Your Vercel domain after deployment)
CLIENT_URL=https://your-project.vercel.app

# Node Environment
NODE_ENV=production
